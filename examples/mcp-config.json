{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/mcp-schema.json",
  "_comment": "Example MCP config — AWM runs as standalone external service. Point to AgentWorkingMemory project.",
  "mcpServers": {
    "agent-working-memory": {
      "command": "npx",
      "args": ["tsx", "/path/to/AgentWorkingMemory/src/mcp.ts"],
      "env": {
        "AWM_DB_PATH": "/path/to/data/memory.db"
      }
    }
  }
}
