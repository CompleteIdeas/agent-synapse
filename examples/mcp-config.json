{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/mcp-schema.json",
  "_comment": "Example MCP config for connecting Claude Code to the AgentSynapse memory server. Place in .claude/mcp.json or ~/.claude/mcp.json",
  "mcpServers": {
    "agent-working-memory": {
      "command": "npx",
      "args": ["tsx", "/path/to/agent-synapse/packages/memory/src/mcp.ts"],
      "env": {
        "AWM_DB_PATH": "/path/to/your-project/data/memory.db"
      }
    }
  }
}
