{
  "_comment": "Service discovery and mode config for AgentSynapse.",
  "mode": "full",
  "mode_options": ["full", "solo_coordinator", "solo_dev"],
  "allow_degraded": false,
  "services": {
    "coordinator": "http://127.0.0.1:8400",
    "memory": "http://127.0.0.1:8400",
    "task_manager": "http://127.0.0.1:8420"
  },
  "_note_coordinator": "Coordinator is now part of AWM (port 8400) when AWM_COORDINATION=true. The separate packages/coordinator/ is deprecated.",
  "stale_threshold_seconds": 120,
  "stale_auto_cleanup": true,
  "loop": {
    "tick_seconds": 180,
    "watchdog_seconds": 420,
    "stale_tick_seconds": 240
  },
  "workspaces": {
    "personal": {
      "name": "PERSONAL",
      "projectDir": "C:\\Users\\robert\\Personal-Projects",
      "agents": [
        { "name": "coordinator", "role": "coordinator", "delay": 0 },
        { "name": "Dev-Lead", "role": "dev-lead", "delay": 5 },
        { "name": "Worker-B", "role": "worker", "delay": 8 },
        { "name": "Worker-C", "role": "worker", "delay": 11 }
      ]
    },
    "work": {
      "name": "WORK",
      "projectDir": "C:\\Users\\robert\\project",
      "agents": [
        { "name": "coordinator", "role": "coordinator", "delay": 0 },
        { "name": "Dev-Lead", "role": "dev-lead", "delay": 5 },
        { "name": "Worker-A", "role": "worker", "delay": 8 },
        { "name": "Worker-B", "role": "worker", "delay": 11 },
        { "name": "Worker-C", "role": "worker", "delay": 14 }
      ]
    }
  }
}
