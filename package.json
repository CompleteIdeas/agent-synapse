{
  "name": "agent-synapse",
  "version": "0.1.0",
  "description": "Multi-agent orchestration with persistent memory for Claude Code",
  "type": "module",
  "bin": {
    "agent-synapse": "bin/synapse.js"
  },
  "scripts": {
    "dev": "node packages/coordinator/dist/index.js & node packages/task-manager/dist/index.js",
    "dev:coordinator": "npx tsx packages/coordinator/src/index.ts",
    "dev:task-manager": "npx tsx packages/task-manager/src/index.ts",
    "build": "npx -p typescript tsc -p packages/memory-client && npx -p typescript tsc -p packages/coordinator && npx -p typescript tsc -p packages/task-manager",
    "prepare": "npm run build || echo build skipped"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "orchestration",
    "memory",
    "claude",
    "claude-code",
    "mcp",
    "cognitive-memory",
    "awm"
  ],
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "fastify": "^5.8.2",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {},
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "author": "Robert Gregg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompleteIdeas/agent-synapse.git"
  },
  "homepage": "https://github.com/CompleteIdeas/agent-synapse#readme",
  "bugs": {
    "url": "https://github.com/CompleteIdeas/agent-synapse/issues"
  }
}
